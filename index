    var cols='grid-template-columns:var(--gl) repeat('+hari.length+',minmax(30px,1fr))';
    var h='<div class="gg" style="'+cols+'"><div class="gh gl" style="grid-row:1">'+BLN[d0.getUTCMonth()]+' '+d0.getUTCFullYear()+'</div>';
    hari.forEach(function(x){var d=pd(x);h+='<div class="gh"><b>'+d.getUTCDate()+'</b>'+HRS[d.getUTCDay()]+'</div>';});
    h+='</div>';
    var grpNow=null,pemenang=[];
    PJ.forEach(function(x){
      if(x.p.mulai!==grpNow){grpNow=x.p.mulai;h+='<div class="gg" style="'+cols+'"><div class="gsep">Masuk UKPBJ '+tglPanjang(pd(grpNow))+'</div></div>';}
      var win=x.j[x.j.length-1].akhir;pemenang.push(win);
      h+='<div class="gg" style="'+cols+'"><div class="gl" title="'+esc(x.p.nama)+'"><span class="gn">'+esc(x.p.nama)+'</span><span class="gm">'+KELAS[x.p.kelas]+', '+m(x.p.pagu)+', pemenang '+tglPendek(win)+'</span></div>';
      hari.forEach(function(s,i){var d=pd(s);h+='<div class="gc'+(d.getUTCDay()===1?' wk':'')+'" style="grid-column:'+(i+2)+';grid-row:1"></div>';});
      var F={},order=[];
      x.j.forEach(function(s){var f=s.t.fase;if(!F[f]){F[f]={a:s.mulai,b:s.akhir};order.push(f);}else{if(s.mulai<F[f].a)F[f].a=s.mulai;if(s.akhir>F[f].b)F[f].b=s.akhir;}});
      order.forEach(function(f){var a=idx(F[f].a),b=idx(F[f].b);
        h+='<div class="gb f-'+f+'" style="grid-column:'+(a+2)+' / '+(b+3)+';grid-row:1" title="'+esc(f+': '+rentang(F[f].a,F[f].b))+'"></div>';});
      h+='</div>';
    });
    document.getElementById(gid).innerHTML=h;
    pemenang.sort(function(a,b){return a-b;});
    var awal=pemenang[0],akhir=pemenang[pemenang.length-1];
    document.getElementById(lid).textContent='Penetapan pemenang diperkirakan '+(ymd(awal)===ymd(akhir)?tglPendek(awal):rentang(awal,akhir))+' '+akhir.getUTCFullYear()+'.';
  }
  renderGantt(PJ,'gantt','ganttLead');
  renderGantt(PJ2,'gantt2','gantt2Lead');

  // rincian per kelompok
  [].forEach.call(document.querySelectorAll('.jadwal-kelompok'),function(el){
    var tgl=el.getAttribute('data-mulai'),no=el.getAttribute('data-kelompok');
    var PJ=SUMBER[el.getAttribute('data-sumber')||'P'];
    var judul=el.getAttribute('data-judul')||('Rincian jadwal kelompok '+no);
    var grp=PJ.filter(function(x){return x.p.mulai===tgl;});
    var ada=URUT_KELAS.filter(function(k){return grp.some(function(x){return x.p.kelas===k;});});
    var h='<h2>'+esc(judul)+'</h2><div class="rule" style="margin-bottom:10px"></div>';
    h+='<p class="lead" style="margin-bottom:12px">Masuk UKPBJ '+tglPanjang(pd(tgl))+', '+grp.length+' paket.</p><div class="kel">';
    if(!grp.length)h+='<p class="muted">Belum ada paket dengan tanggal masuk ini pada data P.</p>';
    ada.forEach(function(k){
      h+='<p><span class="kk k-'+k+'">'+KELAS[k]+'</span>'+grp.filter(function(x){return x.p.kelas===k;}).map(function(x){return esc(x.p.nama)+' ('+m(x.p.pagu)+')';}).join('; ')+'</p>';
    });
    h+='</div>';
    if(grp.length){
      var J={};ada.forEach(function(k){J[k]=jadwal(tgl,k);});
      h+='<div class="sched-wrap"><table class="jd"><thead><tr><th>Tahapan</th>'+ada.map(function(k){return '<th class="c">'+KELAS[k]+'</th>';}).join('')+'</tr></thead><tbody>';
      TAHAP.forEach(function(t,i){
        var last=i===TAHAP.length-1;
        h+='<tr'+(last?' class="win"':'')+'><td>'+esc(t.nama)+'<span class="by">'+esc(t.oleh)+'</span></td>'+
          ada.map(function(k){var s=J[k][i];return '<td class="c">'+rentang(s.mulai,s.akhir)+'</td>';}).join('')+'</tr>';
      });
      h+='</tbody></table></div>';
    }
    el.innerHTML=h;
  });

  // navigasi
  var slides=[].slice.call(document.querySelectorAll('.slide'));
  var cur=0,count_el=document.getElementById('count'),prog=document.getElementById('progress');
  function go(i){
    cur=Math.max(0,Math.min(slides.length-1,i));
    slides.forEach(function(s,k){s.classList.toggle('active',k===cur);s.setAttribute('aria-hidden',k===cur?'false':'true');});
    slides[cur].scrollTop=0;
    count_el.textContent=(cur+1)+' / '+slides.length;
    prog.style.width=((cur+1)/slides.length*100)+'%';
    document.getElementById('prev').disabled=cur===0;
    document.getElementById('next').disabled=cur===slides.length-1;
    document.getElementById('prev').style.opacity=cur===0?.4:1;
    document.getElementById('next').style.opacity=cur===slides.length-1?.4:1;
  }
  document.getElementById('prev').addEventListener('click',function(){go(cur-1);});
  document.getElementById('next').addEventListener('click',function(){go(cur+1);});
  document.addEventListener('keydown',function(e){
    if(e.key==='ArrowRight'||e.key==='PageDown'||(e.key===' '&&!e.shiftKey)){e.preventDefault();go(cur+1);}
    else if(e.key==='ArrowLeft'||e.key==='PageUp'||(e.key===' '&&e.shiftKey)){e.preventDefault();go(cur-1);}
    else if(e.key==='Home'){go(0);} else if(e.key==='End'){go(slides.length-1);}
  });
  var sx=0,sy=0;
  document.getElementById('deck').addEventListener('touchstart',function(e){sx=e.touches[0].clientX;sy=e.touches[0].clientY;},{passive:true});
  document.getElementById('deck').addEventListener('touchend',function(e){
    var dx=e.changedTouches[0].clientX-sx,dy=e.changedTouches[0].clientY-sy;
    if(Math.abs(dx)>60&&Math.abs(dx)>Math.abs(dy)*1.6){go(cur+(dx<0?1:-1));}
  },{passive:true});

  // tema
  var root=document.documentElement;
  document.getElementById('theme').addEventListener('click',function(){
    var dark=root.getAttribute('data-theme')==='dark'||(!root.getAttribute('data-theme')&&window.matchMedia('(prefers-color-scheme: dark)').matches);
    root.setAttribute('data-theme',dark?'light':'dark');
  });

  go(0);
})();
</script>
</body>
</html>
